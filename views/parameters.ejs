<%- include('partials/head', { title }) %>
<%
  const g = params.global;
  const fmt = (x, n = 1) => x === null || x === undefined ? '–' : Number(x).toLocaleString('en-GB', { maximumFractionDigits: n });
  const pctSigned = (m) => { const v = Math.round((m - 1) * 100); return v === 0 ? 'None' : `${v > 0 ? '+' : '−'}${Math.abs(v)}%`; };
  const sourceLabel = { manual: 'Your value', assumption: 'Assumption' };
  const src = (p, key) => {
    const s = p.sources?.[key];
    return sourceLabel[s] ? `<span class="src src--${s}">${sourceLabel[s]}</span>` : '';
  };
  const ok = (part) => part && part.status === 'ok';
  const loc = ctx.other?.location;
  const temps = ctx.weather?.temperatures;
  const fmtDate = (iso) => iso ? new Date(iso + 'T00:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' }) : '';
  const lowCover = rows.filter((r) => r.daysOfCover !== null && r.daysOfCover < g.planningHorizonDays);
  const holidayApplied = rows.filter((r) => r.analysis.adjustment?.holiday?.applied).length;
  const weatherApplied = rows.filter((r) => r.analysis.adjustment?.weather?.applied).length;
  const adjusted = rows.filter((r) => Math.round(((r.params.seasonalMultiplier ?? 1) - 1) * 100) !== 0).length;
  const caps = params.capacity;
  const stypes = caps ? Object.entries(caps.types) : [];
  const hasSpace = stypes.some(([, t]) => t.capacityLitres || t.capacityKg || t.capacityUnits);
%>
<p class="eyebrow">Step 2 of 5</p>
<h1>Planning parameters</h1>
<p class="lead">Estimated from your approved stock counts. Check the figures, correct anything you know better, then approve.</p>

<% if (params.approved) { %>
  <div class="notice notice--success">Approved <%= new Date(params.approvedAt).toLocaleString('en-GB') %>. Saving changes clears the approval and any results based on it. <a href="/scenario">Go to scenario</a></div>
<% } %>
<%- include('partials/errors', { errors }) %>

<div class="glance">
  <div><span class="glance__value"><%= rows.length %></span> products</div>
  <div><span class="glance__value<%= lowCover.length ? ' is-low' : '' %>"><%= lowCover.length %></span> with less stock than <%= g.planningHorizonDays %> days of demand</div>
  <div><span class="glance__value"><%= adjusted %></span> adjusted for school holidays or weather</div>
</div>

<form method="post" action="/parameters" class="form" data-busy="Saving…">
<section class="section">
  <h2>Planning settings</h2>
  <div class="settings-grid">
    <div class="setting">
      <label for="g-horizon">Planning horizon</label>
      <div class="setting__input"><input id="g-horizon" name="global[planningHorizonDays]" type="number" min="1" max="90" step="1" value="<%= g.planningHorizonDays %>"> <span>days</span></div>
      <p class="hint">How far ahead the plan looks.</p>
    </div>
    <div class="setting">
      <label for="g-review">Order every</label>
      <div class="setting__input"><input id="g-review" name="global[reviewPeriodDays]" type="number" min="1" max="28" step="1" value="<%= g.reviewPeriodDays %>"> <span>days</span></div>
      <p class="hint">How often you can place an order.</p>
    </div>
    <div class="setting">
      <label for="g-lead">Usual lead time</label>
      <div class="setting__input"><input id="g-lead" name="global[leadTimeDays]" type="number" min="0" max="60" step="1" value="<%= g.leadTimeDays %>"> <span>days</span></div>
      <p class="hint">From ordering to arrival.</p>
    </div>
    <div class="setting">
      <label for="g-reserve">Emergency reserve</label>
      <div class="setting__input"><input id="g-reserve" name="global[reserveDays]" type="number" min="0" max="21" step="1" value="<%= g.reserveDays %>"> <span>days</span></div>
      <p class="hint">Starting point for Safety first.</p>
    </div>
  </div>
</section>

<section class="section">
  <h2>Products</h2>
  <p class="hint">Weekly demand is estimated from falls in stock between counts, and adjusted automatically for school holidays and weather where your records show an effect.</p>
  <div class="table-scroll">
    <table class="table table--form table--params">
      <thead>
        <tr>
          <th>Product</th><th>Priority</th><th class="num">Stock now</th><th class="num">Days of cover</th>
          <th class="num">Weekly demand</th>
          <th class="num">Lead time</th><th class="num">Shelf life</th><th></th>
        </tr>
      </thead>
      <tbody>
        <% for (const r of rows) { const p = r.params; const dm = r.analysis.demand || {};
             const warnings = (r.analysis.flags || []).filter((f) => f.level === 'warning'); %>
        <tr>
          <td><strong><%= r.product.name %></strong><br><span class="small"><%= categories[r.product.category].label %> · <%= r.product.unit || 'units' %></span></td>
          <td>
            <select name="p[<%= r.id %>][priority]" class="prio-select" data-value="<%= r.product.priority %>" aria-label="Priority for <%= r.product.name %>">
              <% for (const [pid, pr] of Object.entries(priorities)) { %><option value="<%= pid %>"<%= r.product.priority === pid ? ' selected' : '' %>><%= pr.label %></option><% } %>
            </select>
          </td>
          <td class="num"><input name="p[<%= r.id %>][currentStock]" type="number" min="0" step="1" class="input--num" value="<%= p.currentStock %>" aria-label="Stock now"><%- src(p, 'currentStock') %></td>
          <td class="num<%= r.daysOfCover !== null && r.daysOfCover < g.planningHorizonDays ? ' is-low' : '' %>"><%= r.daysOfCover === null ? '–' : fmt(r.daysOfCover, 0) %></td>
          <td class="num">
            <input name="p[<%= r.id %>][weeklyDemand]" type="number" min="0" step="0.1" class="input--num" value="<%= r.weeklyDemand ?? '' %>" aria-label="Weekly demand"><%- src(p, 'dailyDemand') %>
            <% if (dm.weeklyCi95 && p.sources?.dailyDemand !== 'manual') { %><span class="hint nowrap">likely <%= fmt(dm.weeklyCi95[0], 0) %>–<%= fmt(dm.weeklyCi95[1], 0) %></span><% } %>
          </td>
          <td class="num"><input name="p[<%= r.id %>][leadTimeDays]" type="number" min="0" max="60" step="1" class="input--num input--narrow" value="<%= p.leadTimeDays %>" aria-label="Lead time (days)"><%- src(p, 'leadTimeDays') %></td>
          <td class="num"><input name="p[<%= r.id %>][shelfLifeDays]" type="number" min="1" step="1" class="input--num input--narrow" value="<%= p.shelfLifeDays ?? '' %>" placeholder="none" aria-label="Shelf life (days)"><%- src(p, 'shelfLifeDays') %></td>
          <td><a href="#detail-<%= r.id %>" class="detail-link<%= warnings.length ? ' detail-link--warn' : '' %>"><%= warnings.length ? `${warnings.length} to check` : 'Details' %></a></td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <p class="hint">Days of cover is how long current stock lasts, in red when it's shorter than the plan. Lead time and shelf life are in days; leave shelf life blank if the item doesn't go out of date.</p>
</section>

<div class="button-row approve-box">
  <button type="submit" name="action" value="approve" class="button">Approve parameters</button>
  <button type="submit" name="action" value="save" class="button button--secondary">Save draft</button>
</div>
</form>

<section class="section" id="context">
  <h2>How local information is used</h2>
  <div class="context-grid">
    <div class="context-item">
      <h3>School holidays</h3>
      <p class="tag<%= holidayApplied ? ' tag--done' : ' tag--muted' %>"><%= holidayApplied ? `Changes the forecast for ${holidayApplied} product${holidayApplied === 1 ? '' : 's'}` : 'No clear effect in your records' %></p>
      <% const school = ctx.holidays?.school; %>
      <p><strong>In this horizon:</strong> <%= school?.inHorizon?.length ? school.inHorizon.map((h) => `${h.name}, ${fmtDate(h.start)}–${fmtDate(h.end)}`).join('; ') : 'none' %>.</p>
      <p><strong>How it's used:</strong> your records are split into holiday and term-time weeks. Where consumption clearly differs between them, the forecast is adjusted for the holiday days in this horizon.</p>
      <p class="hint">The dates are a fixed calendar of typical England school holidays, not looked up for your council.<% const ls = ctx.other?.localSearch; if (ok(ls) && ls.termDates.length) { %> <a href="<%= ls.termDates[0].url %>">Check your local term dates</a>.<% } %></p>
    </div>

    <div class="context-item">
      <h3>Weather</h3>
      <p class="tag<%= weatherApplied ? ' tag--done' : ' tag--muted' %>"><%= weatherApplied ? `Changes the forecast for ${weatherApplied} product${weatherApplied === 1 ? '' : 's'}` : ok(temps) ? 'No clear effect in your records' : 'Not available' %></p>
      <% if (ok(temps)) { %><p><strong>Next <%= g.planningHorizonDays %> days:</strong> about <%= fmt(temps.horizonMean) %>°C on average.</p><% } %>
      <p><strong>How it's used:</strong> your past consumption is compared with the daily temperature in your area over the same weeks. Where colder or warmer weeks clearly changed consumption, the forecast is adjusted for the temperature expected in this horizon.</p>
      <p class="hint"><%= ok(temps) ? `${temps.source}. ${temps.horizonNote}` : 'Past weather for your area couldn\'t be fetched, so weather isn\'t used.' %></p>
      <% const warn = ctx.weather?.warnings; if (ok(warn) && warn.items.length) { %>
        <ul class="plain-list"><% for (const w of warn.items.slice(0, 2)) { %><li class="note note--warning"><a href="<%= w.link %>"><%= w.title %></a></li><% } %></ul>
        <p class="hint">Met Office warnings are for awareness only.</p>
      <% } %>
    </div>

    <div class="context-item">
      <h3>Your area</h3>
      <p class="tag tag--done">Built into your demand figures</p>
      <% if (ok(loc)) { %>
        <p><%= loc.district %>, <%= loc.region || loc.country %>.<% if (ok(ctx.deprivation)) { %> Deprivation decile <strong><%= ctx.deprivation.imdDecile %> of 10</strong> (1 = most deprived in England, IMD 2025).<% } %></p>
      <% } else { %><p class="hint">Location unavailable.</p><% } %>
      <% const bank = ctx.holidays?.bank; if (ok(bank)) { %>
        <p><%= bank.inHorizon.length ? 'Bank holidays: ' + bank.inHorizon.map((b) => `${b.title} (${fmtDate(b.date)})`).join(', ') + '. Benefits due then are usually paid early.' : 'No bank holidays in this horizon.' %></p>
      <% } %>
    </div>
  </div>
  <form method="post" action="/parameters/context" class="inline-form" data-busy="Refreshing…">
    <span class="hint">Updated <%= ctx.other?.fetchedAt ? new Date(ctx.other.fetchedAt).toLocaleString('en-GB') : 'never' %>.</span>
    <button type="submit" class="link-button">Refresh</button>
  </form>
</section>

<section class="section" id="storage">
  <h2>Storage space</h2>
  <% if (!hasSpace) { %>
    <p>No storage sizes have been entered, so orders aren't limited by space. <a href="/account">Add your storage</a> and Provision will work out how much of each product fits.</p>
  <% } else { %>
    <p>Worked out for you. Each product's size comes from its name and pack size, and space is shared in proportion to how much room each product's consumption takes up, so faster-moving and bulkier items get more.</p>
    <div class="glance glance--small">
      <% for (const [type, t] of stypes) { if (!t.capacityLitres && !t.capacityKg && !t.capacityUnits) continue; %>
      <div>
        <span class="glance__value"><%= t.capacityLitres ? `${fmt(t.capacityLitres, 0)} L` : t.capacityKg ? `${fmt(t.capacityKg, 0)} kg` : `${fmt(t.capacityUnits, 0)} items` %></span>
        <%= type %> space<%= t.currentUse !== null && t.currentUse !== undefined ? `, ${Math.round(t.currentUse * 100)}% full now` : '' %>
      </div>
      <% } %>
    </div>
    <details>
      <summary>Space by product</summary>
      <div class="table-scroll">
        <table class="table table--compact">
          <thead><tr><th>Product</th><th>Kept</th><th class="num">Size of one</th><th class="num">Share of space</th><th class="num">Room for</th><th class="num">Stock now</th></tr></thead>
          <tbody>
            <% for (const r of rows) { const c = r.capacity; const s = r.size; if (!s) continue; %>
            <tr>
              <td><%= r.product.name %></td>
              <td><%= s.storageType %></td>
              <td class="num"><%= fmt(s.unitVolumeL, 2) %> L</td>
              <td class="num"><%= c && c.share !== null && c.share !== undefined ? `${fmt(c.share * 100, 0)}%` : '–' %></td>
              <td class="num"><%= c?.capacity ?? 'No limit' %></td>
              <td class="num"><%= r.params.currentStock %></td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <p class="hint">
        Sizes: <%= params.sizes?.source === 'nebius' ? 'typical UK retail sizes estimated by AI and checked for plausibility' : 'estimated from pack sizes and units' %>.
        <% if (caps.conversions.length) { %>Conversions: <%= caps.conversions.join('; ') %>.<% } %>
        A product's limit is never set below the stock you already hold.
      </p>
    </details>
  <% } %>
</section>

<section class="section" id="details">
  <details class="section-toggle">
  <summary><h2 class="summary-heading">How each estimate was made</h2></summary>
  <% for (const r of rows) { const a = r.analysis; if (!a.observations) continue; const o = a.observations; const dm = a.demand; const adj = a.adjustment || {}; const sup = a.supply || {}; const ex = a.expiry || {}; const t = a.trend || {};
       const warnings = (a.flags || []).filter((f) => f.level === 'warning'); %>
  <details class="detail" id="detail-<%= r.id %>">
    <summary><strong><%= r.product.name %></strong> <span class="small"><%= o.counts %> counts, <%= fmtDate(o.from) %> to <%= fmtDate(o.to) %></span>
      <% if (warnings.length) { %><span class="tag tag--warn"><%= warnings.length %> to check</span><% } %>
    </summary>
    <div class="detail__body">
      <% if (warnings.length) { %>
      <ul class="plain-list"><% for (const f of warnings) { %><li class="note note--warning"><%= f.message %></li><% } %></ul>
      <% } %>
      <div class="detail__chart" data-chart="stock" data-series="<%= JSON.stringify(a.chart) %>" data-unit="<%= r.product.unit || 'unit' %>"></div>

      <ul class="plain-facts">
        <% if (dm.available) { const skipped = o.byType.rise + o.byType.censored + o.byType.excluded; %>
        <li><strong>About <%= fmt(dm.weeklyMean, 0) %> a week.</strong> Across <%= o.counts %> stock counts, stock went down in <%= dm.intervalsUsed %> weeks; we added up how much it dropped and divided by the number of days.<%= skipped ? ` ${skipped} other weeks were left out because a delivery arrived, stock ran out, or a note explained the drop, so they don't show true use.` : '' %></li>
        <li><strong>Usually between <%= fmt(dm.weeklyCi95?.[0], 0) %> and <%= fmt(dm.weeklyCi95?.[1], 0) %> a week.</strong> Some weeks are busier than others by about <%= fmt(dm.weeklySd, 0) %>, so the plans keep enough stock for busier weeks, not just an average one.</li>
        <% } else { %>
        <li>Not enough weeks when stock went down to estimate demand. Enter a weekly figure above.</li>
        <% } %>
        <% for (const line of adj.explanation || []) { %><li><%= line %></li><% } %>
        <% if (t.available && t.clear) { %><li>Use has been <%= t.percentPerMonth > 0 ? 'rising' : 'falling' %> by about <%= fmt(Math.abs(t.percentPerMonth), 0) %>% a month (not applied automatically).</li><% } %>
      </ul>

      <% if (ex.batches?.length) { %>
      <h3>Current stock by date</h3>
      <table class="table table--compact">
        <thead><tr><th>Best before</th><th class="num">Quantity</th><th class="num">Days left</th><th class="num">Likely left on that date</th></tr></thead>
        <tbody>
          <% for (const b of ex.batches) { %>
          <tr><td><%= fmtDate(b.expiryDate) %><%- b.atRisk ? ' <span class="tag tag--warn">Give out first</span>' : '' %></td><td class="num"><%= b.quantity %></td><td class="num"><%= b.daysToExpiry %></td><td class="num"><%= b.expectedUnused ?? '–' %></td></tr>
          <% } %>
        </tbody>
      </table>
      <% } %>
    </div>
  </details>
  <% } %>
  </details>
</section>
<%- include('partials/foot') %>
