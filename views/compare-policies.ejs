<%- include('partials/head', { title }) %>
<%
  const P = ['lean', 'balanced', 'resilient'];
  const pol = sim.policies;
  const n0 = (x) => x === null || x === undefined ? null : Math.round(x).toLocaleString('en-GB');
  const pc = (x) => x === null || x === undefined ? null : `${Math.round(x * 100)}%`;
  const diff = (x, base, fmt = (v) => Math.round(v).toLocaleString('en-GB'), scale = 1) => {
    if (x === null || x === undefined || base === null || base === undefined) return '';
    const d = (x - base) * scale;
    if (Math.abs(d) < 0.5) return '<span class="delta">same as Balanced</span>';
    return `<span class="delta">${d > 0 ? '+' : '−'}${fmt(Math.abs(d))} vs Balanced</span>`;
  };
  const insufficient = '<span class="insufficient">Insufficient data</span>';
  const rowsDef = [
    ['Request now', 'Units to order today (the day-0 order)', (t) => n0(t.initialOrder), (t) => t.initialOrder],
    ['Expected shortfall', 'Units people needed when the shelf was empty, on average', (t) => n0(t.expectedUnmet), (t) => t.expectedUnmet],
    ['Shortfall in a bad month', 'Average shortfall in the worst 5% of futures', (t) => n0(t.unmetCvar95), (t) => t.unmetCvar95],
    ['Chance any critical or essential item runs short', 'Share of futures where at least one of them runs out', (t) => pc(t.protectedShortageProbability), null],
    ['Critical and essential products short', 'How many of them are expected to run out at least once', (t) => t.expectedProtectedProductsShort === null ? null : `${t.expectedProtectedProductsShort.toFixed(1)} of ${t.protectedProducts}`, (t) => t.expectedProtectedProductsShort],
    ['Expected waste', 'Units passing their best-before date before use', (t) => n0(t.expectedWaste), (t) => t.expectedWaste],
    ['Expected stock at the end', 'Units on the shelf at the end of the horizon', (t) => n0(t.expectedEnding), (t) => t.expectedEnding],
  ];
  const productIds = Object.keys(sim.inputs).sort((a, b) => {
    const rank = { critical: 0, essential: 1, standard: 2 };
    return rank[products[a].priority] - rank[products[b].priority] || pol.balanced.products[b].shortageProbability - pol.balanced.products[a].shortageProbability;
  });
  const cfg = sim.config;
%>
<p class="eyebrow">Step 4 of 5</p>
<h1>Compare policies</h1>
<p class="lead"><strong><%= scenarioLabel %></strong> over <%= cfg.planningHorizonDays %> days. Every figure is an estimate from <%= cfg.numberOfRuns.toLocaleString('en-GB') %> simulated futures that all three policies share. No policy is best in every way: choose the trade-off that suits your food bank.</p>
<p><a href="/scenario">Change the scenario</a></p>

<section class="section">
  <div class="table-scroll">
    <table class="table compare-table">
      <thead>
        <tr>
          <th scope="col">Measure</th>
          <% for (const p of P) { %>
          <th scope="col" class="num<%= selected === p ? ' is-selected' : '' %>">
            <%= labels[p] %><%= selected === p ? ' (selected)' : '' %>
            <span class="compare-table__desc"><%= sim.policyDescriptions[p] %></span>
          </th>
          <% } %>
        </tr>
      </thead>
      <tbody>
        <% for (const [label, hint, show, raw] of rowsDef) { %>
        <tr>
          <th scope="row"><%= label %><span class="hint"><%= hint %></span></th>
          <% for (const p of P) { const t = pol[p].totals; const v = show(t); %>
          <td class="num<%= selected === p ? ' is-selected' : '' %>">
            <%- v === null ? insufficient : `<span class="metric">${v}</span>` %>
            <%- p !== 'balanced' && raw && v !== null ? diff(raw(t), raw(pol.balanced.totals)) : '' %>
          </td>
          <% } %>
        </tr>
        <% } %>
        <tr>
          <th scope="row">Storage<span class="hint">How full your storage gets, from the space you entered</span></th>
          <% for (const p of P) { const t = pol[p].totals; const su = t.spaceUse; const cut = (t.capacityLimitedProducts || []).map((id) => products[id]?.name).filter(Boolean); %>
          <td class="<%= selected === p ? 'is-selected' : '' %> small">
            <% if (su) { for (const [type, x] of Object.entries(su)) { %><span class="space-use"><%= type[0].toUpperCase() + type.slice(1) %>: up to <%= Math.round(x.peak * 100) %>% full</span><% } } else { %>No storage sizes entered<% } %>
            <span class="space-use<%= cut.length ? ' is-low' : '' %>"><%= cut.length ? `Orders cut to fit: ${cut.join(', ')}` : 'Every order fits' %></span>
          </td>
          <% } %>
        </tr>
        <tr class="choose-row">
          <th scope="row"></th>
          <% for (const p of P) { %>
          <td class="<%= selected === p ? 'is-selected' : '' %>">
            <form method="post" action="/compare/select" data-busy="Preparing plan…">
              <input type="hidden" name="policy" value="<%= p %>">
              <button type="submit" class="button<%= selected === p ? '' : ' button--secondary' %>">Choose <%= labels[p] %></button>
            </form>
          </td>
          <% } %>
        </tr>
      </tbody>
    </table>
  </div>
</section>

<section class="section">
  <h2>Outcomes side by side</h2>
  <div class="grid-2">
    <div><h3>Shortage, waste and stock left</h3><div class="chart" id="chart-outcomes"></div></div>
    <div><h3>How bad shortages get across futures</h3><div class="chart" id="chart-distribution"></div><p class="hint">Total unmet demand in each simulated future. Further right means worse.</p></div>
  </div>
  <h3>Chance of a shortage by product</h3>
  <div class="chart chart--tall" id="chart-products"></div>
</section>

<section class="section">
  <h2>By product</h2>
  <div class="table-scroll">
    <table class="table">
      <thead>
        <tr>
          <th rowspan="2">Product</th><th rowspan="2">Priority</th><th rowspan="2" class="num">Stock now</th><th rowspan="2" class="num">Expected demand</th>
          <% for (const p of P) { %><th colspan="2" class="num group-head<%= selected === p ? ' is-selected' : '' %>"><%= labels[p] %></th><% } %>
        </tr>
        <tr><% for (const p of P) { %><th class="num<%= selected === p ? ' is-selected' : '' %>">Request</th><th class="num<%= selected === p ? ' is-selected' : '' %>">Shortage chance</th><% } %></tr>
      </thead>
      <tbody>
        <% for (const id of productIds) { const inp = sim.inputs[id]; const pr = products[id]; %>
        <tr>
          <td><%= pr.name %></td>
          <td><span class="tag tag--<%= pr.priority %>"><%= pr.priority[0].toUpperCase() + pr.priority.slice(1) %></span></td>
          <td class="num"><%= inp.currentStock %></td>
          <td class="num"><%= Math.round(inp.expectedDemandHorizon) %></td>
          <% for (const p of P) { const r = pol[p].products[id]; %>
          <td class="num<%= selected === p ? ' is-selected' : '' %>"><%= r.initialOrder %></td>
          <td class="num<%= selected === p ? ' is-selected' : '' %><%= r.shortageProbability >= 0.5 ? ' is-low' : '' %>"><%= pc(r.shortageProbability) %></td>
          <% } %>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <p class="hint">Expected demand is the forecast for the <%= cfg.planningHorizonDays %>-day horizon after any scenario adjustment, in each product's unit.</p>
</section>

<section class="section">
  <h2>Assumptions behind these results</h2>
  <ul class="plain-list"><% for (const a of sim.assumptions) { %><li class="note"><%= a %></li><% } %></ul>
</section>

<script type="application/json" id="compare-data"><%- JSON.stringify({
  labels,
  selected,
  totals: Object.fromEntries(P.map((p) => [p, pol[p].totals])),
  distribution: sim.distribution.unmetTotal,
  products: productIds.map((id) => ({ name: products[id].name, ...Object.fromEntries(P.map((p) => [p, pol[p].products[id].shortageProbability])) })),
}).replace(/</g, '\\u003c') %></script>
<%- include('partials/foot') %>
