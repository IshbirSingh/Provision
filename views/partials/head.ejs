<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title ? `${title} – SupplyShield` : 'SupplyShield' %></title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="wordmark" href="/">SupplyShield</a>
    <% if (user) { %>
      <% if (organisation && organisation.name) { %><span class="site-header__org"><%= organisation.name %></span><% } %>
      <nav class="site-header__links" aria-label="Account">
        <a href="/account">Organisation</a>
        <form method="post" action="/logout" class="inline-form">
          <button type="submit" class="link-button">Sign out</button>
        </form>
      </nav>
    <% } %>
  </div>
</header>

<% if (user && typeof hideSteps === 'undefined') { %>
<nav class="steps" aria-label="Workflow">
  <ol class="wrap steps__list">
    <% for (const step of workflow.steps) {
         const current = currentPath === step.path || (step.id === 'data' && currentPath === '/review'); %>
      <li class="steps__item<%= current ? ' is-current' : '' %><%= step.done ? ' is-done' : '' %><%= step.unlocked ? '' : ' is-locked' %>">
        <% if (step.unlocked) { %>
          <a href="<%= step.path %>"<%- current ? ' aria-current="step"' : '' %>><span class="steps__num"><%= step.number %></span> <%= step.label %></a>
        <% } else { %>
          <span><span class="steps__num"><%= step.number %></span> <%= step.label %></span>
        <% } %>
      </li>
    <% } %>
  </ol>
</nav>
<% } %>

<main id="main" class="wrap main">
<% if (flash) { %>
  <div class="notice notice--<%= flash.type %>" role="status"><%= flash.message %></div>
<% } %>
