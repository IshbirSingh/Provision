<%- include('partials/head', { title }) %>
<%
  const R = record.recommendation;
  const S = R.summary;
  const P = ['lean', 'balanced', 'resilient'];
  const policy = record.selectedPolicy;
  const ft = record.fineTune;
  const cfg = record.scenario;
  const g = record.parameters.global;
  const rows = R.order.map((id) => R.products[id]);
  const n0 = (x) => x === null || x === undefined ? null : Math.round(x).toLocaleString('en-GB');
  const n1 = (x) => x === null || x === undefined ? null : Number(x).toLocaleString('en-GB', { maximumFractionDigits: 1 });
  const pc = (x) => x === null || x === undefined ? null : `${Math.round(x * 100)}%`;
  const u = (n, unit) => `${Math.round(n).toLocaleString('en-GB')} ${unit || 'unit'}${Math.round(n) === 1 ? '' : 's'}`;
  const longDate = (iso) => iso ? new Date(iso + 'T00:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', timeZone: 'UTC' }) : '';
  const insufficient = '<span class="insufficient">Insufficient data</span>';
  const planLabel = ft ? `${labels[policy]} at ${Math.round(ft.level * 100)}%` : labels[policy];
  const scenarioLines = [record.scenarioLabel];
  if (cfg.demandIncrease > 0) scenarioLines.push(`demand ${pc(cfg.demandIncrease)} higher`);
  if (cfg.applyReserve) scenarioLines.push(`${cfg.reserveDays}-day reserve`);
  if (cfg.additionalDeliveryDelayDays > 0) scenarioLines.push(`deliveries ${cfg.additionalDeliveryDelayDays} days late`);
  if (cfg.deliveryQuantityReduction > 0) scenarioLines.push(`deliveries ${pc(cfg.deliveryQuantityReduction)} smaller`);
  const ap = record.explanations.actionPlan;
  const fp = record.explanations.finalPlan;
  const sourceLine = (x) => x ? (x.source === 'nebius' ? 'Written by AI from the calculated results and checked against them.' : 'Written from the calculated results.') : '';
  const levelPct = Math.round((ft ? ft.level : defaultLevel) * 100);
  const defaultPct = Math.round(defaultLevel * 100);
  // Columns for the plan comparison: the three policies, plus the adjusted plan.
  const columns = P.map((p) => [p, labels[p] + (ft && p === policy ? ' (standard)' : ''), record.policies[p]]);
  if (ft && record.adjusted) columns.splice(P.indexOf(policy) + 1, 0, ['adjusted', planLabel, record.adjusted]);
  const isChosen = (key) => key === (ft ? 'adjusted' : policy);
  const startIso = record.calculation.asOf || (record.createdAt || new Date().toISOString()).slice(0, 10);
  const dayDate = (n) => new Date(Date.parse(startIso + 'T00:00:00Z') + n * 86400000).toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' });
  const orderDays = record.calculation.orderDays || [];
  const scheduled = rows.filter((r) => (r.schedule || []).some((x) => Math.round(x.mean) > 0));
%>
<p class="eyebrow">Step 5 of 5</p>
<h1><%= finalised ? 'Finalised plan' : 'Your plan' %></h1>
<p class="lead"><strong><%= planLabel %></strong> · <%= scenarioLines.join(', ') %> · next <%= cfg.planningHorizonDays %> days.</p>

<% if (finalised) { %>
  <div class="notice notice--success">
    <p><strong>Finalised <%= new Date(record.createdAt).toLocaleString('en-GB') %></strong> by <%= record.createdBy?.name || 'a manager' %>. The numbers are now fixed. Provision doesn't place any orders.</p>
    <div class="button-row">
      <a class="button" href="/plan/print?id=<%= record.id %>">Printable plan</a>
      <a href="/scenario">Start a new plan</a>
    </div>
  </div>
<% } %>
<% if (S.warnings.length) { %>
  <div class="notice notice--warning"><ul><% for (const w of S.warnings) { %><li><%= w %></li><% } %></ul></div>
<% } %>

<section class="section">
  <div class="kpis">
    <div class="kpi">
      <span class="kpi__label">Request now</span>
      <span class="kpi__value"><%= n0(S.totalReplenish) %> <small>units</small></span>
      <span class="kpi__note">across <%= S.productsToReplenish %> of <%= rows.length %> products</span>
    </div>
    <div class="kpi">
      <span class="kpi__label">Expected shortfall</span>
      <span class="kpi__value"><%= n0(S.expectedUnmet) %> <small>units</small></span>
      <span class="kpi__note"><%= S.expectedProtectedProductsShort === null ? '' : `about ${n1(S.expectedProtectedProductsShort)} of ${S.protectedProducts} critical or essential products run short` %></span>
    </div>
    <div class="kpi">
      <span class="kpi__label">Expected waste</span>
      <span class="kpi__value"><%- S.expectedWaste === null ? insufficient : `${n0(S.expectedWaste)} <small>units</small>` %></span>
      <span class="kpi__note">passing their best-before date</span>
    </div>
    <div class="kpi">
      <span class="kpi__label">Emergency reserve</span>
      <span class="kpi__value"><%= n0(S.emergencyReserveUnits) %> <small>units</small></span>
      <span class="kpi__note">buffer for critical and essential items</span>
    </div>
    <div class="kpi<%= S.expiryAlerts ? ' kpi--alert' : '' %>">
      <span class="kpi__label">Give out first</span>
      <span class="kpi__value"><%= S.expiryAlerts %> <small>product<%= S.expiryAlerts === 1 ? '' : 's' %></small></span>
      <span class="kpi__note">with stock reaching its date soon</span>
    </div>
  </div>
  <p class="hint">Shortfall and waste are estimates from <%= record.calculation.runs.toLocaleString('en-GB') %> simulated futures.</p>
</section>

<% if (!finalised && canSwitch) { %>
<section class="section fine-tune" id="fine-tune">
  <h2>Fine-tune protection</h2>
  <p>The chance of <em>not</em> running out of each product over the next <%= cfg.planningHorizonDays %> days. Higher protection holds more stock; lower holds less. The standard <%= labels[policy] %> level is <%= defaultPct %>%<%= policy === 'resilient' ? ' for critical items, a little lower for others' : '' %>.</p>
  <form method="post" action="/plan/fine-tune" class="fine-tune__form" data-busy="Re-running…">
    <div class="slider-row">
      <input type="range" id="level" name="level" min="50" max="99" step="1" value="<%= levelPct %>" aria-describedby="level-out" oninput="document.getElementById('level-out').textContent = this.value + '%'">
      <output id="level-out" for="level"><%= levelPct %>%</output>
    </div>
    <div class="button-row">
      <button type="submit" class="button button--secondary">Re-run this plan</button>
      <% if (ft) { %><button type="submit" name="level" value="<%= defaultPct %>" class="link-button">Back to standard (<%= defaultPct %>%)</button><% } %>
    </div>
  </form>
</section>
<% } %>

<% if (scheduled.length && orderDays.length > 1) { %>
<section class="section">
  <h2>Order plan for the next <%= cfg.planningHorizonDays %> days</h2>
  <p class="hint">Today's figures are firm. Later ones are what's typically needed if demand runs as expected; re-count and update the plan before each order.</p>
  <div class="table-scroll">
    <table class="table schedule-table">
      <thead><tr><th>Product</th><% for (const d of orderDays) { %><th class="num"><%= d === 0 ? 'Today' : dayDate(d) %></th><% } %></tr></thead>
      <tbody>
        <% for (const r of scheduled) { %>
        <tr>
          <td><%= r.name %> <span class="small"><%= r.unit ? `(${r.unit}s)` : '' %></span></td>
          <% for (const x of r.schedule) { const v = Math.round(x.mean); %>
          <td class="num<%= x.day === 0 ? ' schedule-today' : '' %>"><%= v > 0 ? (x.day === 0 ? n0(v) : `about ${n0(v)}`) : '–' %></td>
          <% } %>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>
<% } %>

<section class="section">
  <h2>What to do today</h2>
  <p class="hint">Most urgent first. Open a row to see how it was worked out.</p>
  <div class="table-scroll">
    <table class="table rec-table">
      <thead>
        <tr>
          <th>Product</th><th class="num">Stock now</th><th class="num">Expected demand</th><th class="num">Request</th>
          <th class="num">Reserve</th><th class="num">Shortage risk</th><th>Give out first</th><th>Priority</th>
        </tr>
      </thead>
      <% for (const r of rows) {
           const inp = record.forecastModel[r.productId];
           const ev = record.evidence[r.productId] || {};
           const pp = (ft && record.adjusted ? record.adjusted : record.policies[policy]).products[r.productId];
           const L = policy === 'resilient' ? inp.leadTimeDisrupted : inp.leadTime;
           const q = pp.quantile;
           const rawQ = Math.max(0, pp.target - r.currentStock); %>
      <tbody class="rec rec--<%= r.urgency %>">
        <tr>
          <td>
            <strong><%= r.name %></strong> <span class="small"><%= r.unit ? `(${r.unit}s)` : '' %></span>
            <% if (r.urgency !== 'normal') { %><br><span class="tag <%= r.urgency === 'act_now' ? 'tag--alert' : r.urgency === 'high' ? 'tag--warn' : 'tag--expiry' %>"><%= urgency[r.urgency].label %></span><% } %>
          </td>
          <td class="num"><%= n0(r.currentStock) %></td>
          <td class="num"><%= n0(r.expectedDemand) %></td>
          <td class="num"><strong class="replenish"><%= r.replenish ? '+' + n0(r.replenish) : '–' %></strong></td>
          <td class="num"><%= n0(r.emergencyReserve) %></td>
          <td class="num<%= r.riskReasons?.length ? ' is-low' : '' %>"><%= pc(r.shortageRisk) %></td>
          <td><%= r.expiring.quantity ? `${n0(r.expiring.quantity)} by ${longDate(r.expiring.earliestDate)}` : '–' %></td>
          <td><span class="tag tag--<%= r.priority %>"><%= r.priority[0].toUpperCase() + r.priority.slice(1) %></span></td>
        </tr>
        <tr class="why-row">
          <td colspan="8">
            <% if (r.riskReasons?.length) { %>
            <div class="risk-reasons"><strong>Why the risk is high:</strong> <%= r.riskReasons.join(' ') %></div>
            <% } %>
            <details class="why">
              <summary>Why this recommendation?</summary>
              <div class="why__body">
                <p class="why__lead"><strong><%= r.replenish > 0 ? `Request ${u(r.replenish, r.unit)} today.` : 'Nothing needed today.' %></strong></p>
                <ul class="plain-facts">
                  <li>You have <%= u(r.currentStock, r.unit) %><%= ev.stock?.snapshotDate ? ` (counted ${longDate(ev.stock.snapshotDate)})` : '' %> and usually give out about <%= n0(7 * inp.mu) %> a week<%= inp.mu !== inp.muHat ? ' (adjusted for holidays, weather or the scenario)' : '' %>.</li>
                  <li>An order takes <%= inp.leadTimeDisrupted %> days to arrive<%= inp.leadTimeDisrupted !== inp.leadTime ? ` in this scenario (usually ${inp.leadTime})` : '' %>, and you can order every <%= g.reviewPeriodDays %> days.</li>
                  <li>This plan aims for about a <strong><%= Math.round((r.riskTarget ?? 0) * 100) %>% chance of running out</strong> over the next <%= cfg.planningHorizonDays %> days. To get there it keeps up to <%= n0(r.target) %> in stock<%= pp.reserveBinding ? ', enough to meet the emergency reserve' : '' %>.</li>
                  <% if (r.replenish !== rawQ) { %><li>The order is smaller than it would be because there's only room for about <%= n0(inp.capacity) %>.</li><% } %>
                  <li>Across <%= record.calculation.runs.toLocaleString('en-GB') %> simulated futures it runs out in <strong><%= pc(r.shortageRisk) %></strong><%= r.shortageBeforeFirstDelivery > 0.05 ? `, mostly before the first delivery can arrive (${pc(r.shortageBeforeFirstDelivery)})` : '' %>.<%= r.expectedWaste ? ` About ${n1(r.expectedWaste)} is likely to go out of date.` : '' %></li>
                </ul>
                <div class="why__chart" data-chart="projection" data-series="<%= JSON.stringify(record.projected[r.productId] || null) %>" data-unit="<%= r.unit || 'unit' %>"></div>
              </div>
            </details>
          </td>
        </tr>
      </tbody>
      <% } %>
    </table>
  </div>
</section>

<% if (finalised && fp) { %>
<section class="section plan-box">
  <h2>Action plan</h2>
  <div class="plan-sections">
    <% for (const [key, label] of [['request', 'Request'], ['prioritise', 'Prioritise'], ['distributeFirst', 'Give out first'], ['maintain', 'Keep in reserve'], ['monitor', 'Keep an eye on']]) { if (!fp.sections[key]?.length) continue; %>
    <div class="plan-section"><h3><%= label %></h3><ul><% for (const s of fp.sections[key]) { %><li><%= s %></li><% } %></ul></div>
    <% } %>
  </div>
  <p class="hint"><%= sourceLine(fp) %></p>
</section>
<% } else if (ap) { %>
<section class="section plan-box">
  <h2>Action plan</h2>
  <div class="plan-sections">
    <% for (const [key, label] of [['whatToRequest', 'What to request'], ['whenToAct', 'When to act'], ['immediatePriorities', 'Priorities'], ['contingency', 'If things go wrong']]) { if (!ap.sections[key]?.length) continue; %>
    <div class="plan-section"><h3><%= label %></h3><ul><% for (const s of ap.sections[key]) { %><li><%= s %></li><% } %></ul></div>
    <% } %>
  </div>
  <p class="hint"><%= sourceLine(ap) %></p>
</section>
<% } %>

<section class="section">
  <h2>How the plans compare</h2>
  <% if (ap?.sections?.tradeoffSummary?.length) { %><p><%= ap.sections.tradeoffSummary.join(' ') %></p><% } %>
  <div class="table-scroll">
    <table class="table">
      <thead><tr><th></th><% for (const [key, label] of columns) { %><th class="num<%= isChosen(key) ? ' is-selected' : '' %>"><%= label %><%= isChosen(key) ? ' (yours)' : '' %></th><% } %></tr></thead>
      <tbody>
        <% for (const [label, f] of [
          ['Request now (units)', (t) => n0(t.initialOrder)],
          ['Critical or essential products expected to run short', (t) => t.expectedProtectedProductsShort === null ? null : `${n1(t.expectedProtectedProductsShort)} of ${t.protectedProducts}`],
          ['Expected shortfall (units)', (t) => n0(t.expectedUnmet)],
          ['Shortfall in the worst 5% of futures', (t) => n0(t.unmetCvar95)],
          ['Expected waste (units)', (t) => n0(t.expectedWaste)],
          ['Emergency reserve (units)', (t) => n0(t.emergencyReserveUnits)],
        ]) { %>
        <tr><th scope="row"><%= label %></th><% for (const [key, , pol] of columns) { const v = f(pol.totals); %><td class="num<%= isChosen(key) ? ' is-selected' : '' %>"><%- v === null ? insufficient : v %></td><% } %></tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <% if (canSwitch) { %>
  <div class="button-row">
    <% for (const p of P.filter((x) => x !== policy)) { %>
    <form method="post" action="/compare/select" class="inline-form" data-busy="Switching…"><input type="hidden" name="policy" value="<%= p %>"><button type="submit" class="button button--secondary">Switch to <%= labels[p] %></button></form>
    <% } %>
    <a href="/compare">Full comparison</a>
  </div>
  <% } %>
</section>

<% if (!finalised) { %>
<section class="section finalise-box">
  <h2>Confirm and finalise</h2>
  <p>This fixes the <strong><%= planLabel %></strong> plan and saves it with everything needed to check it later. Provision doesn't place any orders.</p>
  <form method="post" action="/plan/finalise" data-busy="Finalising…">
    <button type="submit" class="button button--large">Confirm &amp; finalise plan</button>
  </form>
</section>
<% } %>

<section class="section">
  <details>
    <summary><h2 class="summary-heading">Audit trail</h2></summary>
    <div class="audit">
      <p>Everything needed to check or reproduce this plan without re-running any AI.</p>
      <dl class="summary">
        <div><dt>Stock data</dt><dd><%= record.dataset ? `${record.dataset.sourceFile || 'Manual entry'}: ${record.dataset.rowsUsed} rows used, ${record.dataset.rowsExcluded} left out` : '–' %></dd></div>
        <div><dt>Parameters approved</dt><dd><%= record.parameters.approvedAt ? new Date(record.parameters.approvedAt).toLocaleString('en-GB') : '–' %></dd></div>
        <div><dt>Simulation</dt><dd><%= record.calculation.runs.toLocaleString('en-GB') %> futures, random seed <%= record.calculation.seed %>, run <%= new Date(record.calculation.ranAt).toLocaleString('en-GB') %></dd></div>
        <div><dt>Checks</dt><dd><%= record.calculation.checks.inventoryNonNegative && record.calculation.checks.inventoryBalances ? 'Passed: stock never negative, stock balances, the same futures for every plan' : 'A check failed' %></dd></div>
        <div><dt>Choice</dt><dd><%= record.policyConstraints.selectionCriteria %></dd></div>
      </dl>
      <h3>Formulas</h3>
      <dl class="summary formulas">
        <% for (const [name, tex, meaning] of record.formulas) { %>
        <% if (meaning === undefined) { /* plans finalised before formulas were stored as TeX */ %>
        <div><dt><%= name %></dt><dd><%= tex %></dd></div>
        <% } else { %>
        <div><dt><%= name %></dt><dd><span class="formula" data-tex="<%= tex %>"></span><span class="hint"><%= meaning %></span></dd></div>
        <% } %>
        <% } %>
      </dl>
      <h3>Assumptions</h3>
      <ul class="plain-list"><% for (const a of record.assumptions) { %><li class="note"><%= a %></li><% } %></ul>
      <% if (finalised) { %>
      <h3>Audit file</h3>
      <p>A machine-readable copy of this record: every number, setting and the random seed. Keep it if you need to show how a decision was made or to reproduce the plan exactly. It isn't needed day to day.</p>
      <p><a href="/plan/download?id=<%= record.id %>">Download audit file (JSON)</a></p>
      <% } %>
    </div>
  </details>
</section>
<%- include('partials/foot') %>
